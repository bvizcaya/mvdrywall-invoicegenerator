<body>
    <div class="wrap">
        <header>
            <div>
                <h1>Invoice <span class="mark">History</span></h1>
                <div class="subtitle">Search, re-download, and export past documents</div>
            </div>
            <div class="nav-links">
                <a href="index.html">New Invoice</a>
                <a href="dashboard.html">Analytics</a>
            </div>
        </header>

        <div id="loadingState" class="state">Loading your records…</div>
        <div id="errorState" class="state error" style="display:none;"></div>

        <div id="content" style="display:none;">
            <div class="toolbar">
                <div class="field">
                    <label for="search">Search</label>
                    <input type="text" id="search" placeholder="Client, address, or invoice number…" oninput="applyFilters()">
                </div>
                <div class="field">
                    <label for="typeFilter">Type</label>
                    <select id="typeFilter" onchange="applyFilters()">
                        <option value="">All</option>
                        <option value="invoice">Invoices</option>
                        <option value="estimate">Estimates</option>
                    </select>
                </div>
                <div class="field">
                    <label for="yearFilter">Year</label>
                    <select id="yearFilter" onchange="applyFilters()">
                        <option value="">All years</option>
                    </select>
                </div>
                <div class="field">
                    <label for="exportYear">Tax export</label>
                    <select id="exportYear">
                        <option value="">Select year…</option>
                    </select>
                </div>
                <button class="btn btn-accent" onclick="exportTaxCsv()">Download CSV</button>
            </div>

            <div class="panel">
                <h2>Documents</h2>
                <div class="hint">Click a column to sort. Re-download rebuilds the original PDF from your records.</div>
                <div class="count" id="resultCount"></div>
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th onclick="sortBy('number')">No.</th>
                                <th onclick="sortBy('date')">Date</th>
                                <th onclick="sortBy('type')">Type</th>
                                <th onclick="sortBy('client')">Client</th>
                                <th onclick="sortBy('address')">Job Site</th>
                                <th onclick="sortBy('amount')" style="text-align:right;">Amount</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="tbody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <footer>
            Reads live from your Google Sheet · <a href="index.html">← Back to invoice generator</a>
        </footer>
    </div>

    <script>

        const SHEET_URL = 'https://script.google.com/macros/s/AKfycbzzbctiNuqKW10e1Uzwdzv6R9SeApVNhE4silRcbL0VpSV-Za7dbJW9bJ2dYGijqgqRJw/exec';

        let allRows = [];
        let filtered = [];
        let sortState = { key: 'date', dir: -1 };

        const money = (n) => '$' + Number(n || 0).toLocaleString('en-US', { maximumFractionDigits: 0 });
        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => (
            { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
        ));

        function show(id) {
            ['loadingState', 'errorState', 'content'].forEach(s => {
                document.getElementById(s).style.display = (s === id) ? 'block' : 'none';
            });
        }

        async function loadData() {
            show('loadingState');
            try {
                const res = await fetch(SHEET_URL);
                if (!res.ok) throw new Error('Request failed (' + res.status + ')');
                const rows = await res.json();
                if (!Array.isArray(rows) || rows.length === 0) {
                    document.getElementById('errorState').textContent = 'No documents logged yet.';
                    show('errorState');
                    return;
                }

                allRows = rows.map(r => {
                    const d = new Date(r.invoiceDate);
                    return {
                        number: r.invoiceNumber || '',
                        type: String(r.documentType || '').toLowerCase(),
                        client: r.customerName || r.customerBusiness || 'Unknown',
                        business: r.customerBusiness || '',
                        address: r.address || '',
                        date: isNaN(d) ? null : d,
                        rawDate: r.invoiceDate || '',
                        jobDate: r.jobDate || 'N/A',
                        amount: parseFloat(r.amount) || 0,
                        comments: r.comments || 'N/A'
                    };
                }).filter(r => r.date);

                populateYears();
                applyFilters();
                show('content');
            } catch (err) {
                document.getElementById('errorState').textContent =
                    'Could not load records: ' + err.message + '. Check that the Apps Script doGet is deployed.';
                show('errorState');
                console.error(err);
            }
        }

        function populateYears() {
            const years = [...new Set(allRows.map(r => r.date.getFullYear()))].sort((a, b) => b - a);
            const opts = years.map(y => `<option value="${y}">${y}</option>`).join('');
            document.getElementById('yearFilter').innerHTML = '<option value="">All years</option>' + opts;
            document.getElementById('exportYear').innerHTML = '<option value="">Select year…</option>' + opts;
        }

        function applyFilters() {
            const q = document.getElementById('search').value.trim().toLowerCase();
            const type = document.getElementById('typeFilter').value;
            const year = document.getElementById('yearFilter').value;

            filtered = allRows.filter(r => {
                if (type && r.type !== type) return false;
                if (year && r.date.getFullYear() !== Number(year)) return false;
                if (q) {
                    const hay = (r.client + ' ' + r.address + ' ' + r.number).toLowerCase();
                    if (!hay.includes(q)) return false;
                }
                return true;
            });

            renderTable();
        }

        function sortBy(key) {
            if (sortState.key === key) sortState.dir *= -1;
            else { sortState.key = key; sortState.dir = (key === 'amount' || key === 'date' || key === 'number') ? -1 : 1; }
            renderTable();
        }

        function renderTable() {
            const rows = [...filtered].sort((a, b) => {
                let av = a[sortState.key], bv = b[sortState.key];
                if (sortState.key === 'number') { av = Number(av) || 0; bv = Number(bv) || 0; }
                if (av < bv) return -1 * sortState.dir;
                if (av > bv) return 1 * sortState.dir;
                return 0;
            });

            document.getElementById('resultCount').textContent =
                `${rows.length} document${rows.length === 1 ? '' : 's'}` +
                (rows.length !== allRows.length ? ` (of ${allRows.length})` : '');

            const tbody = document.getElementById('tbody');
            if (rows.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--dim);padding:32px;">No documents match your filters.</td></tr>';
                return;
            }

            tbody.innerHTML = rows.map((r, i) => {
                const idx = allRows.indexOf(r);
                const convertBtn = r.type === 'estimate'
                    ? `<button class="mini convert" onclick="convertToInvoice(${idx})">→ Invoice</button>`
                    : '';
                return `
                <tr>
                    <td class="num">${r.number ? esc(r.number) : '—'}</td>
                    <td>${r.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td>
                    <td><span class="tag ${esc(r.type)}">${esc(r.type)}</span></td>
                    <td>${esc(r.client)}</td>
                    <td style="color:var(--dim);">${esc(r.address)}</td>
                    <td class="amt">${money(r.amount)}</td>
                    <td>
                        <div class="actions">
                            ${convertBtn}
                            <button class="mini" onclick="redownload(${idx})">Re-download</button>
                        </div>
                    </td>
                </tr>`;
            }).join('');
        }

        // Rebuilds the original PDF from the stored record
        function redownload(idx) {
            const r = allRows[idx];
            if (!r) return;
            try {
                downloadInvoicePDF({
                    documentType: r.type,
                    invoiceNumber: r.number,
                    customer: { name: r.client, business: r.business, address: '' },
                    address: r.address,
                    invoiceDate: r.rawDate,
                    jobDate: r.jobDate,
                    amount: r.amount,
                    comments: r.comments
                });
            } catch (err) {
                alert('Could not rebuild the PDF: ' + err.message);
                console.error(err);
            }
        }

        // Sends the estimate's details to the generator, prefilled as an invoice
        function convertToInvoice(idx) {
            const r = allRows[idx];
            if (!r) return;
            const p = new URLSearchParams({
                client: r.client,
                address: r.address,
                jobDate: r.jobDate,
                amount: String(r.amount),
                comments: r.comments
            });
            window.location.href = 'index.html?' + p.toString();
        }

        // Year-end CSV for a bookkeeper — invoices only, since estimates aren't income
        function exportTaxCsv() {
            const year = document.getElementById('exportYear').value;
            if (!year) { alert('Pick a year to export.'); return; }

            const rows = allRows
                .filter(r => r.type === 'invoice' && r.date.getFullYear() === Number(year))
                .sort((a, b) => a.date - b.date);

            if (rows.length === 0) { alert('No invoices found for ' + year + '.'); return; }

            const q = (v) => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
            const header = ['Invoice Number', 'Date', 'Client', 'Job Site Address', 'Job Date', 'Amount', 'Comments'];
            const lines = [header.map(q).join(',')];

            let total = 0;
            rows.forEach(r => {
                total += r.amount;
                lines.push([
                    q(r.number),
                    q(r.date.toLocaleDateString('en-US')),
                    q(r.client),
                    q(r.address),
                    q(r.jobDate),
                    q(r.amount.toFixed(2)),
                    q(r.comments)
                ].join(','));
            });
            lines.push('');
            lines.push([q(''), q(''), q(''), q(''), q('TOTAL'), q(total.toFixed(2)), q('')].join(','));

            const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `MV_Drywall_Invoices_${year}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        loadData();
    </script>
</body>
</html>
